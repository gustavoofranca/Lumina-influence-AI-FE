# Copie para .env. Base da API REST do back-end Lumina.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# E-mail publicado nas páginas legais (/privacidade, /termos, /exclusao-de-dados).
# Precisa ser o mesmo e-mail de contato registrado no app da Meta: divergência
# entre a política e as configurações do app é motivo de rejeição no App Review.
VITE_CONTACT_EMAIL=

# Mascara de apresentacao: troca nomes e esconde a midia do CDN da Meta nas
# respostas da API. So para gravacao local: coloque no .env.local (ignorado pelo
# Git), nunca aqui. Formato de=>para;de=>para (exemplo ficticio abaixo).
# VITE_MASCARAS=fulana.beltrana=>pessoa.teste;beltrana=>teste

# Modo apresentacao: esconde IDs internos, @, transcricao, cartoes operacionais
# e botoes de editar/excluir para a gravacao do TCC (ver src/lib/apresentacao.js).
# So no .env.local da maquina que grava; sem a variavel o site fica como e.
# VITE_MODO_APRESENTACAO=true
